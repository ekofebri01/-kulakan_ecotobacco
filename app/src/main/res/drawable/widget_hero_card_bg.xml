<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Semi-transparent modern hero card with subtle green-teal tint and glass border -->
    <gradient
        android:angle="135"
        android:startColor="#80103B32"
        android:centerColor="#73112E3B"
        android:endColor="#660D202D"
        android:type="linear" />
    <corners android:radius="14dp" />
    <stroke
        android:width="1dp"
        android:color="#4D34D399" />
</shape>
