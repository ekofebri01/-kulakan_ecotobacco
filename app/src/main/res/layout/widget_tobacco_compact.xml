<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Mini Left: App Icon & Brand -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_widget_inventory" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="ECO"
            android:textColor="#F59E0B"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Mini Center: Total Kulakan Bulan Ini -->
    <LinearLayout
        android:id="@+id/card_widget_hero"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_hero_card_bg"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="KULAKAN BULAN INI"
            android:textColor="#34D399"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_tv_total_kulakan_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="Rp 0"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_tv_kulakan_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="0 Trx • 0 kg"
            android:textColor="#CBD5E1"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Mini Right: 2 Quick Action Buttons Vertical -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Quick Kulakan -->
        <LinearLayout
            android:id="@+id/btn_widget_input_kulakan"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/widget_btn_kulakan_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="Input Kulakan"
                android:src="@drawable/ic_widget_add" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Kulakan"
                android:textColor="#064E3B"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Quick Plan -->
        <LinearLayout
            android:id="@+id/btn_widget_bikin_rencana"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_btn_plan_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="Bikin Rencana"
                android:src="@drawable/ic_widget_plan" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Rencana"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hidden elements for provider binding compatibility -->
    <TextView
        android:id="@+id/widget_tv_month_badge"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_tv_last_update"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/btn_widget_refresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/card_widget_plans"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_tv_active_plans"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/widget_tv_plan_items"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/card_widget_stock"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_tv_total_products"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
